# =============================================================================
# Opportuni — variables de entorno (guía)
# Copia este archivo a `.env.local` y llena los valores. NO subas `.env.local`.
# Las que empiezan con NEXT_PUBLIC_ se exponen al navegador (no pongas secretos).
# =============================================================================

# ---- Servicios de pago ----
# Los pagos on-chain (wallet Accesly) se retiraron. Las tarjetas de "Review de
# CV" y "Asesoría 1:1" del home están desactivadas hasta definir otro medio de
# cobro; /cv y /cv/asesoria siguen cobrando por transferencia (CLABE en el
# código de esas páginas) y no necesitan variables aquí.

# ---- Post-pago ----
# Google Calendar de citas (versión embebible con ?gv=true).
NEXT_PUBLIC_CALENDLY_URL=https://calendar.google.com/calendar/appointments/schedules/XXXX?gv=true

# ---- Dashboard admin (/admin) ----
# SOLO servidor. Contraseña del equipo (mínimo 12 caracteres) y secreto para
# firmar la cookie de sesión (mínimo 32 caracteres: openssl rand -hex 32).
# Sin las dos, /admin no deja entrar y /api/admin/* responde 401.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# (Opcional) Google Calendar/agenda para embeber en "Reuniones".
NEXT_PUBLIC_ADMIN_CALENDAR_URL=

# ---- Base propia (Postgres + PostgREST en db.opportuni.xyz, PRD 8.10) ----
# Los valores reales salen de infra/db/generar-llaves.sh en el servidor.
# DB_URL (o SUPABASE_URL, el nombre viejo) es la API de la base, sin /rest/v1.
DB_URL=https://db.opportuni.xyz
# Rol anon: lecturas públicas (vacantes activas) y postulantes.
SUPABASE_ANON_KEY=
# Rol service_role, SOLO servidor: pasaportes, clicks, formulario y admin.
DB_SERVICE_TOKEN=

# ---- Puerta del pasaporte (/v/{slug}) ----
# SOLO servidor. Mínimo 32 caracteres cada uno (openssl rand -hex 32).
# Firma la cookie opp_dev del dispositivo. Si cambia, todos los dispositivos
# vuelven a ver la puerta (y entran con "Ya tengo pasaporte").
DEVICE_COOKIE_SECRET=
# HMAC del IP de cada click (nunca se guarda el IP en claro).
IP_HASH_SECRET=

# ---- Vercel Blob (almacenamiento de CVs) ----
# SECRETO — no lo expongas. Obténlo en Vercel → Storage → tu Blob store.
# Sin él, la subida cae a ./uploads local (solo dev).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
# Informativos (opcionales; solo si activas webhooks de Blob):
BLOB_STORE_ID=store_xxxxxxxxxxxx
BLOB_WEBHOOK_PUBLIC_KEY=

# Dune: solo local, para scripts/dune.py (queries del dashboard en analytics/dune).
API_DUNE=
